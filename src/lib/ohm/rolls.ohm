Rolls {
	Rolls
        = Roll? (#("," | " ") Roll)*
    
    Roll
    	= ArithmeticRoll
        | SignedRoll
        | PrimaryRoll
    
    ArithmeticRoll
    	= Roll operator PrimaryRoll
        
    SignedRoll
    	= operator PrimaryRoll
        
    PrimaryRoll
        = MinMaxRoll
        | advantageRoll
        | diceRoll
        | LiteralRoll
        | ParenRoll

    ParenRoll
        = "(" Roll ")"
    
    MinMaxRoll
    	= (caseInsensitive<"min"> | caseInsensitive<"max">) "(" Rolls ")"
    
    LiteralRoll
    	= integer

    integer
        = digit+
    
    operator
    	= "-" | "+"
        
    diceRoll
    	= integer? caseInsensitive<"d"> integer
    
    advantageRoll
    	= diceRoll (caseInsensitive<"a"> | caseInsensitive<"d">)
}